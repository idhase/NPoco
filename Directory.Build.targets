<Project>
   <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NPoco'">
     <PackageId>Idha.NPoco</PackageId>
   </PropertyGroup>
 
   <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NPoco.SqlServer'">
     <PackageId>Idha.NPoco.SqlServer</PackageId>
   </PropertyGroup>

   <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NPoco.Abstractions'">
     <PackageId>Idha.NPoco.Abstractions</PackageId>
   </PropertyGroup>

   <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NPoco.JsonNet'">
     <PackageId>Idha.NPoco.JsonNet</PackageId>
   </PropertyGroup>

   <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NPoco.SqlServer.SystemData'">
     <PackageId>Idha.NPoco.SqlServer.SystemData</PackageId>
   </PropertyGroup>

   <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NPoco.FluentSql'">
     <PackageId>Idha.NPoco.FluentSql</PackageId>
   </PropertyGroup>

   <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NPoco.Tests'">
     <IsPackable>false</IsPackable>
   </PropertyGroup>

   <!-- Fork identity. Kept here rather than in the .csproj files so that merges from
        upstream (schotime/NPoco) never conflict: this file does not exist upstream.
        Directory.Build.targets is imported after each project, so these win. -->
   <PropertyGroup Condition="$(PackageId.StartsWith('Idha.'))">
     <Version>1.0.0</Version>
     <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
     <Authors>IDHA Sweden AB</Authors>
     <Company>IDHA Sweden AB</Company>
     <Copyright>Copyright (c) Adam Schroder and NPoco contributors. Fork maintained by Idha.</Copyright>
     <PackageProjectUrl>https://github.com/idhase/NPoco</PackageProjectUrl>
     <RepositoryUrl>https://github.com/idhase/NPoco</RepositoryUrl>
     <RepositoryType>git</RepositoryType>
     <PackageReleaseNotes>https://github.com/idhase/NPoco/blob/master/CHANGELOG.md</PackageReleaseNotes>
     <PackageTags>$(PackageTags);fork;openjson</PackageTags>
     <!-- Apache-2.0 4(a): every distributed package must carry the licence.
          Upstream only sets this on NPoco itself, so the sibling packages shipped without it. -->
     <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
     <Description>$(Description)

Unofficial fork of NPoco (https://github.com/schotime/NPoco) by Adam Schroder, adding OPENJSON-based IN clause support for SQL Server 2016 and later. Not affiliated with or endorsed by the NPoco project. Ships as NPoco.dll, so it cannot be installed alongside the official NPoco package.</Description>
   </PropertyGroup>

   <ItemGroup Condition="$(PackageId.StartsWith('Idha.'))">
     <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="/" Visible="false" />
     <None Include="$(MSBuildThisFileDirectory)src/NPoco/LICENSE.txt" Pack="true" PackagePath="/" Visible="false"
           Condition="'$(MSBuildProjectName)' != 'NPoco'" />
   </ItemGroup>
 </Project>